; GodBotScalper v2.0 - US30 M1 - 3 Contracts Fixed
; H1 Technical Summary (26 indicators) - Fixed Lot - No Martingale
;
; Backtest results (US30 M1, Feb 2025 - Feb 2026, $100K account):
;   Trades/Day : ~91.5     Avg Profit/Day : ~$603
;   Annual     : ~$219K    Return         : ~219% on $100K
;   PF         : 1.315     Sharpe         : 12.29
;   MaxDD      : ~$3,000   (~3% of $100K)
;   Win Rate   : 24.4%     Avg Trade      : 9 min
;
; Combined with XAUUSD 0.14 lot (GodBotScalper_XAUUSD_M1_3pct.set):
;   Total Daily : ~$1,016/day
;   Total Annual: ~$370K
;   Combined MaxDD: ~$6,000 (independent signals)
;
; Strategy:
;   Direction : H1 Technical Summary (investing.com, 26 indicators)
;               Score >= +7 -> BUY | Score <= -7 -> SELL
;   Lot Size  : Fixed 3.0 lots/contracts (no martingale)
;   Cooldown  : 4 M1 bars (~4 min min between entries -> ~91 trades/day)
;   Exit      : TP = 3.0x ATR | SL = 0.75x ATR
;
; H1 Direction filter
InpTSThresh=7

; Exit (M1 ATR)
InpATRPeriod=21
InpTP_ATR=3.0
InpSL_ATR=0.75

; Fixed 3 contracts - NO martingale
InpBaseLot=3.0
InpMaxMartLevel=0

; Frequency (M1: 4 bars cooldown -> ~91 trades/day)
InpCooldownBars=4

; Hedge mode off
InpHedgeMode=false

; Trade (use different magic from XAUUSD instance)
InpMagic=20250302
InpHedgeMagic=true
