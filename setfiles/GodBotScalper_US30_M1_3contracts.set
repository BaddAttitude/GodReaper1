; GodBotScalper v2.0 - US30 M1 - 5 Contracts Optimised
; H1 Technical Summary (26 indicators) - Fixed Lot - No Martingale
;
; Backtest results (US30 M1, Feb 2025 - Feb 2026):
;   Trades/Day : ~107      Avg Profit/Day : ~$1,153
;   Annual     : ~$419K    PF             : 1.310
;   Sharpe     : 13.30     Sortino        : 123.05
;   MaxDD      : ~0.165%   SQN            : 14.84
;   Win Rate   : 24.3%     Avg Trade      : 9 min
;
; Combined with XAUUSD 0.14 lot (GodBotScalper_XAUUSD_M1_3pct.set):
;   Total Daily : ~$1,566/day  ($413 XAUUSD + $1,153 US30)
;   Total Annual: ~$571K
;
; Optimisation notes:
;   - Increased from 3 -> 5 contracts (+67% lot size)
;   - Reduced cooldown from 4 -> 2 bars (+17% trade frequency)
;   - CD=2 improves Sharpe 12.56->13.30 and SQN 13.95->14.84 on US30
;
; Strategy:
;   Direction : H1 Technical Summary (investing.com, 26 indicators)
;               Score >= +7 -> BUY | Score <= -7 -> SELL
;   Lot Size  : Fixed 5.0 lots/contracts (no martingale)
;   Cooldown  : 2 M1 bars (~2 min between entries -> ~107 trades/day)
;   Exit      : TP = 3.0x ATR | SL = 0.75x ATR
;
; H1 Direction filter
InpTSThresh=7

; Exit (M1 ATR)
InpATRPeriod=21
InpTP_ATR=3.0
InpSL_ATR=0.75

; Fixed 5 contracts - NO martingale
InpBaseLot=5.0
InpMaxMartLevel=0

; Frequency (M1: 2 bars cooldown -> ~107 trades/day)
InpCooldownBars=2

; Hedge mode off
InpHedgeMode=false

; Trade (use different magic from XAUUSD instance)
InpMagic=20250302
InpHedgeMagic=true
