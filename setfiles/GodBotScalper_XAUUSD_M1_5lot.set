; GodBotScalper v2.0 - XAUUSD M1 - HIGH LOT: 5.0 base
; H1 Technical Summary (26 indicators) + Martingale + Hedge
;
; Backtest projection (XAUUSD M1, Feb 2025 - Feb 2026):
;   BaseLot: 5.0    MaxLot: 80.0   Trades/Day: ~53
;   Return : ~+508%  PF: 1.34  Sharpe: ~9.95  MaxDD: ~-17.5%
;
; WARNING: 80-lot max exposure is VERY AGGRESSIVE.
;   At XAUUSD ~$2900 with 1:500 leverage:
;   Max margin needed = 80 lots x $2900 x 100oz / 500 = ~$46,400
;   Recommended minimum account: $100,000+
;   ONLY use if your broker allows 80+ lots on a single position.
;
; Direction filter (H1 Tech Summary)
;   Score >= +7 -> BUY | Score <= -7 -> SELL

; H1 Direction filter
InpTSThresh=7

; Exit (M1 ATR)
InpATRPeriod=21
InpTP_ATR=3.0
InpSL_ATR=0.75

; Martingale (5.0->10.0->20.0->40.0->80.0 lots)
