InpMaxMartLevel=4

; Frequency (M1: 12 bars = ~53 trades/day)
InpCooldownBars=12

; Hedge mode (off by default)
InpHedgeMode=false

; Trade
InpMagic=20250301
InpHedgeMagic=true
